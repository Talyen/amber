# Required by SEC EDGAR fair access policy (format: "AppName ContactEmail")
SEC_USER_AGENT="AmberStocks research@amberstocks.com"

# Neon Postgres connection string (add via Vercel Marketplace -> Neon)
# DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret for On-Demand ISR cache revalidation webhook (/api/revalidate)
# REVALIDATE_SECRET="generate-a-random-32-char-secret"

# Optional: Batch LLM extraction key for Filing Diff Radar (GitHub Actions only; never used at runtime)
# GEMINI_API_KEY=""

# Required for filing alert confirmation on Vercel and delivery in GitHub Actions
# RESEND_API_KEY=""
# ALERT_FROM_EMAIL="Amber Alerts <alerts@amberstocks.com>"

# Optional billing configuration
# STRIPE_SECRET_KEY=""
