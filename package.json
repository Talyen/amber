{
  "name": "amber",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts tests",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types tests/*.test.ts",
    "ingest:edgar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/ingest-edgar.ts",
    "ingest:diffs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/extract-filing-diffs.ts",
    "ingest:8k": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/ingest-8k.ts",
    "ingest:proxy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/ingest-proxy.ts",
    "ingest:form4": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/ingest-form4.ts",
    "sync:prices": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/sync-prices.ts",
    "send:alerts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/send-filing-alerts.ts",
    "db:push": "drizzle-kit push",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/migrate-db.ts",
    "db:migrate:production": "pnpm db:migrate --production",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/seed-neon.ts",
    "smoke:prod": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/smoke-prod.ts",
    "release": "pnpm db:migrate:production && vercel --prod --project=amber --scope=talyen-s-projects --yes --non-interactive"
  },
  "dependencies": {
    "@microsoft/focusgroup-polyfill": "^1.0.2",
    "@neondatabase/serverless": "^1.2.1",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.18",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "pg": "^8.23.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3"
  }
}
